# IMPORTANT: Set this environment variable in Vercel Dashboard
# Project Settings → Environment Variables
#
# Variable: ENABLE_EXPERIMENTAL_COREPACK
# Value: 1
#
# This enables Corepack which will respect the packageManager field
# in package.json and use pnpm@8.15.0 instead of the default pnpm@6.x
#
# Without this, Vercel will use pnpm 6.x which is incompatible with
# the project's requirement of pnpm >=8.0.0

ENABLE_EXPERIMENTAL_COREPACK=1
