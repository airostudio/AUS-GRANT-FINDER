# AusGrant-Finder Environment Variables
# Copy to .env.local for local development

# =============================================================================
# OPTIONAL: All variables below are optional.
# The system works with sensible defaults if not set.
# =============================================================================

# -----------------------------------------------------------------------------
# Vercel KV (Redis) - Distributed Rate Limiting
# -----------------------------------------------------------------------------
# Auto-set by Vercel when you create a KV database
# Leave empty for local development (uses in-memory fallback)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# -----------------------------------------------------------------------------
# Sentry - Error Monitoring (OPTIONAL)
# -----------------------------------------------------------------------------
# Get from: https://sentry.io/settings/projects/your-project/keys/
# Leave empty to disable error monitoring
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Australian Government API Keys (ALL OPTIONAL)
# -----------------------------------------------------------------------------
# Most government APIs don't require keys.
# Add these only if you have authenticated access.

# Federal APIs
AUSTENDER_API_URL=https://api.tenders.gov.au
# AUSTENDER_API_KEY=

GRANTCONNECT_API_URL=https://www.grants.gov.au
# GRANTCONNECT_API_KEY=

ARC_API_URL=https://www.arc.gov.au/jsonapi/node/funding_opportunity

# State APIs - NSW
DATA_NSW_API_URL=https://data.nsw.gov.au/data/api/3
# NSW_OPENGOV_API_KEY=

# State APIs - Queensland
DATA_QLD_API_URL=https://www.data.qld.gov.au/api/3
# QLD_API_KEY=

# State APIs - Victoria
DATA_VIC_API_URL=https://www.data.vic.gov.au/data/api/3
# VIC_API_KEY=

# Local Government
BRISBANE_API_URL=https://data.brisbane.qld.gov.au/api/explore/v2.1/catalog/datasets/grants-recipients

# -----------------------------------------------------------------------------
# Node Environment (auto-set by Vercel)
# -----------------------------------------------------------------------------
NODE_ENV=development
