# API Configuration
# ==================

# Use mock data (true) or fetch from real APIs (false)
# Set to true for development/testing, false for production
USE_MOCK_DATA=true

# AusTender API Configuration
# GitHub: https://github.com/austender/austender-ocds-api
# Leave empty if using public endpoints
AUSTENDER_API_URL=https://api.tenders.gov.au
AUSTENDER_API_KEY=

# Australian Research Council (ARC) Grants API
# URL: https://www.arc.gov.au/funding-research/funding-outcomes/grants-dataset
ARC_API_URL=https://www.arc.gov.au/api/grants

# Brisbane City Council Grants API
# URL: https://data.brisbane.qld.gov.au/explore/dataset/grants-recipients/api/
BRISBANE_API_URL=https://data.brisbane.qld.gov.au/api/explore/v2.1/catalog/datasets/grants-recipients

# NSW OpenGov API
# Apply for API key at: https://data.nsw.gov.au/
DATA_NSW_API_URL=https://data.nsw.gov.au/api
NSW_OPENGOV_API_KEY=

# Queensland Open Data API
# URL: https://www.data.qld.gov.au/
DATA_QLD_API_URL=https://www.data.qld.gov.au/api

# Cache Configuration
# ==================

# Enable API response caching (recommended for production)
ENABLE_API_CACHE=true

# Cache duration in minutes
CACHE_DURATION_MINUTES=15

# Rate Limiting
# =============

# Maximum requests per second per API
MAX_REQUESTS_PER_SECOND=10
